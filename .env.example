# Plik .env jest opcjonalny - wszystkie sekrety możesz trzymać też w config.yaml.
# Jeśli wolisz oddzielać sekrety od konfiguracji - skopiuj ten plik do `.env`
# i wpisz wartości tutaj. Wartości z .env mają pierwszeństwo nad config.yaml.

# TELEGRAM_BOT_TOKEN=123456:ABCdefGhIJklmNOPqrSTUvwxYZ
# TELEGRAM_CHAT_ID=123456789
